# Database
DATABASE_URL=postgresql+asyncpg://medibot:medibot@localhost:5433/medibot_v2

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_AUX=gpt-4o-mini

# Pinecone
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=medibot-v2
PINECONE_NAMESPACE=medibot

# LangSmith (free tier tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=medibot-v2

# App
APP_ENV=development
RATE_LIMIT_PER_MINUTE=10
SEMANTIC_CACHE_THRESHOLD=0.95
MAX_CRAG_RETRIES=1
MEMORY_WINDOW=3
