{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-lint.sh",
            "description": "Auto-format and lint Python on every file write"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "postgres-medibot": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://medibot:medibot@localhost:5433/medibot_v2"
      ],
      "description": "Postgres access for schema inspection and retrieval_logs debugging"
    },
    "filesystem-medibot": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "description": "Filesystem scoped to project root"
    },
    "github-medibot": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_TOKEN"},
      "description": "GitHub PR/issue management"
    }
  }
}